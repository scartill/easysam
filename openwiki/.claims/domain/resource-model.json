  "claims": [
    {
      "id": "claim_70ed54cae0764af39e538b890333d406",
      "statement": "EasySAM uses a two-tier YAML model: a root resources.yaml defines global resources and import directories, and per-directory easysam.yaml files define local lambdas, tables, and nested imports.",
      "evidence": [
        {
          "resource": "repo://src/easysam/load.py#L259-L290",
          "version": "repo-lines-v1:sha256:5b3760dd25a1c87a87f6aa823c3277b70fc765cb86d7e98db40938ff3de53884:"
        },
        {
          "resource": "repo://src/easysam/load.py#L56-L110",
          "version": "repo-lines-v1:sha256:ab6c5818829637770f7da35c3ac12dbf74f46feca042dd76859679185f14a05c:"
        }
      ]
    },
    {
      "id": "claim_a5f11470bee94742b57bf0e094a7d0d6",
      "statement": "The resources() function in load.py is the main entry point for loading resources, following a sequence of: locate resources.yaml, load .env, register !Conditional constructor, parse YAML, expand env vars, wrap in benedict, resolve conditionals, apply overrides, preprocess imports/defaults/sorting, validate, and check lambda layer.",
      "evidence": [
        {
          "resource": "repo://src/easysam/load.py#L56-L110",
          "version": "repo-lines-v1:sha256:ab6c5818829637770f7da35c3ac12dbf74f46feca042dd76859679185f14a05c:"
        }
      ]
    },
    {
