  "claims": [
    {
      "id": "claim_82dd20dfbd4040ea828f319018af6a2b",
      "statement": "The local execution server reuses the same `load.resources()` loader that drives cloud generation and deployment, so local testing sees the same resolved resource model (conditionals applied, imports merged, defaults set, Prismarine tables preprocessed) without performing template rendering, SAM build, or CloudFormation deployment.",
      "evidence": [
        {
          "resource": "repo://src/easysam/local_cli.py#L115-L118",
          "version": "repo-lines-v1:sha256:2e8c8eafec0b61a3260efccad68bcc85fb91488b65a4b7b56429564db883fe8e:"
        },
        {
