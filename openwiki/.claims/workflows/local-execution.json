    {
      "id": "claim_c40ac75f713049e890bbc7b26be7a19f",
      "statement": "Route construction in `local_routes.py` converts the resolved resource model into a sorted list of `RouteInfo` descriptors: non-greedy API paths become single exact routes, greedy paths expand into an exact route plus a catch-all `/{path:path}` route with `resource_path` set to `/{proxy+}` for AWS parity, and function URLs with `functionurl: true` are registered separately under `/__fn/{name}`; routes are sorted so non-greedy entries come before greedy catch-alls to prevent Starlette from shadowing exact routes.",
      "evidence": [
        {
          "resource": "repo://src/easysam/local_routes.py#L15-L79",
          "version": "repo-lines-v1:sha256:fdc14c01d4a9532a02333bb055502c3ae0b53f71895599b0f2830d6ce8494834:"
        },
