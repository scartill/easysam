    },
    {
      "id": "claim_50cd66d83535464c9bf955445d3d6104",
      "statement": "Per-request handler invocation is serialized by a module-level `asyncio.Lock` named `_invocation_lock`, and per-function environment variables from `functions[name]['envvars']` are saved, set into `os.environ`, and restored in a `try...finally` block inside the lock so that an unhandled exception in the handler or event building cannot leave the lock permanently acquired or `os.environ` mutated; body reading and event synthesis happen outside the lock so concurrent requests do not block on `await request.body()`.",
      "evidence": [
        {
          "resource": "repo://src/easysam/local_server.py#L201-L223",
          "version": "repo-lines-v1:sha256:d7b1d6c948f50eebeb0c7907179184508d0c6fd7cea93cd69a8f781595982e08:"
        },
        {
          "resource": "repo://src/easysam/local_server.py#L90-L91",
          "version": "repo-lines-v1:sha256:780b5c553d0a337b4d3122f097b301fe1d54b71553ba988bf7919aa04c581cae:"
