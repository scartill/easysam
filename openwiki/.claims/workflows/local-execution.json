    {
      "id": "claim_5482a6b3f2f1424fa1330c760bd4af55",
      "statement": "Handler isolation is implemented by the `isolated_import_context` context manager in `local_handler.py`, which resolves `project_root` and `lambda_dir` to absolute paths, removes stale `common.*` modules from `sys.modules` whose `__file__` resolves under the project root on entry, sets `sys.path = [lambda_dir, project_root] + sys.path` so handler-local modules and `common/` resolve from source, imports `lambda_dir/index.py` via `importlib.util` under a unique per-invocation module name, and purges all modules whose resolved `__file__` starts with `project_root` or `lambda_dir` on exit while leaving third-party packages in `sys.modules`; `load_and_invoke` then dispatches on `inspect.iscoroutinefunction(handler)` to await async handlers directly or run sync handlers in a freshly created event loop via `run_in_executor`.",
      "evidence": [
        {
          "resource": "repo://src/easysam/local_handler.py#L37-L81",
          "version": "repo-lines-v1:sha256:2048acbf6b7ee5f3ed59b8a7e253b286bedbcee694ad03c9d3d7cc908b7e75f9:"
