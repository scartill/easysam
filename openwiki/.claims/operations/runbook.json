    },
    {
      "id": "claim_f6937b9f9caf45c9bc2d554e99e09456",
      "statement": "The `commondep` module (`src/easysam/commondep.py`) traces `common.*` imports using AST analysis: it scans `common/` for available packages (directories and `.py` files excluding `__`-prefixed names), parses each Lambda's Python files for `import common.X` and `from common.X import ...`, recursively traces transitive dependencies, and returns the sorted list of required modules for copying into each Lambda directory.",
      "evidence": [
        {
          "resource": "repo://src/easysam/commondep.py#L16-L91",
          "version": "repo-lines-v1:sha256:31bec1cdf676963bf607ec9da48a0d3cd5cf7b5231d18c5d718854ad3c842ad0:"
