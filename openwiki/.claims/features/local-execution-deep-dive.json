          "version": "repo-lines-v1:sha256:8c03cdb7867e5a785c81c333cf6461f6a9ee76aaac0375f3a9ada180e4495d39:"
        },
        {
          "resource": "repo://src/easysam/local_event.py#L167-L187",
          "version": "repo-lines-v1:sha256:26eb1abbf59db942829d04c4c5f6372baf4c8b09c119ab677a900b343d80d98b:"
        },
        {
          "resource": "repo://src/easysam/local_event.py#L48-L104",
          "version": "repo-lines-v1:sha256:7c95f24bb0932c57acdb43844ce3938486a5084d9058e2255f4f0b3d41ff6dce:"
        }
