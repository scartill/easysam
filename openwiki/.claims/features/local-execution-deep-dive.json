          "version": "repo-lines-v1:sha256:07f755c650fe6a4ce51d2379beccf9eb432a650ca99a73702a5a8966abf67790:"
        },
        {
          "resource": "repo://src/easysam/local_server.py#L191-L227",
          "version": "repo-lines-v1:sha256:719fa5bfdb12242d63a098cfac7241bb0aa711a8e9968a5aa64ccfd784c8ca36:"
        },
        {
          "resource": "repo://src/easysam/local_server.py#L90-L91",
          "version": "repo-lines-v1:sha256:780b5c553d0a337b4d3122f097b301fe1d54b71553ba988bf7919aa04c581cae:"
        }
      ]
    },
    {
      "id": "claim_12b5148f8d6e4541ba118f389e249bb3",
      "statement": "Response normalization in `local_server.py`'s `normalize_response` translates Lambda handler output to HTTP responses: dicts with `statusCode` use the status code, headers, and body (with base64 decoding when `isBase64Encoded: True`); dicts without `statusCode` are auto-wrapped as JSON 200 (v2 parity); strings/primitives are wrapped as plain text 200; and uncaught handler exceptions return 500 with a formatted traceback in the body.",
      "evidence": [
