    {
      "id": "claim_efa3ebfb8bfa40acb905cd8c77011fe5",
      "statement": "Binary request bodies are base64-encoded in both event builders when the content type is in `BINARY_CONTENT_TYPES` (application/octet-stream, image/png, image/jpeg, image/gif, image/webp, application/pdf, application/zip); otherwise the body is decoded as UTF-8 with error replacement.",
      "evidence": [
        {
          "resource": "repo://src/easysam/local_event.py#L14-L45",
          "version": "repo-lines-v1:sha256:667732203cb412dceaf933caafb43a46cc460b8376d85e48f5b9fdcb677253db:"
        }
      ]
    },
    {
      "id": "claim_976699758c4b4e2fb7907fac8f1e7328",
      "statement": "Authorization is stubbed globally — authorizer Lambdas are not executed locally; instead `--auth-context` (a JSON file path or inline JSON string) provides a fixed `requestContext.authorizer` payload injected into every request's event, defaulting to `{}` if omitted. The CLI parses it with `_parse_json_option`, which tries file path first (trapping `OSError`/`ValueError` on Windows) then falls back to inline JSON parsing.",
      "evidence": [
        {
          "resource": "repo://docs/specs/local-lambda-execution.md#L16-L16",
          "version": "repo-lines-v1:sha256:5c1d4f19f838e75a214503b1db81b320bbd848d02376f8bd25264c900a0f7102:"
        },
        {
