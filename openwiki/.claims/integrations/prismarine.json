  "claims": [
    {
      "id": "claim_9bfd3591c4e34bbb880958afa78da629",
      "statement": "EasySAM consumes the Prismarine package at two distinct pipeline stages: preprocessing in load.py (via preprocess_prismarine) to generate DynamoDB table definitions merged into resources_data['tables'], and client code generation in prismarine.py (via generate()) after template rendering to produce prismarine_client.py with typed CRUD methods.",
      "evidence": [
        {
          "resource": "repo://src/easysam/load.py#L11-L12",
          "version": "repo-lines-v1:sha256:92c069876cc93cde60564f54b898ea921581d1e90503e142f77f04da2a97f233:"
        },
        {
          "resource": "repo://src/easysam/load.py#L136-L179",
          "version": "repo-lines-v1:sha256:ba98c9612fb797d3cddbf30a81b44eb7892af42be0847c5432d21f3f404edf04:"
        },
